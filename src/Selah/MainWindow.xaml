<Window x:Class="Selah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selah" Width="148" Height="6" MinWidth="148" MaxWidth="760" MinHeight="6" MaxHeight="450"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#252B39"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#30394A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#252A33"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#343B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#081218"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#292F3D"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202635"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="IslandSurface"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource IslandBackgroundBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="0" CornerRadius="0,0,3,3" Padding="0"
            ClipToBounds="True"
            MouseEnter="IslandSurface_MouseEnter"
            MouseLeave="IslandSurface_MouseLeave">

        <Grid>
            <!-- Hover state: a compact pill appears below the tiny idle notch. -->
            <Grid x:Name="CompactContent" Visibility="Collapsed">
                <Button Click="ExpandButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Padding="12,0" Cursor="Hand"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="SELAH" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CompactClockText" Grid.Column="2" Text="14:51" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Expanded panel: compact horizontal navigation, like Nusa's desktop panel. -->
            <Grid x:Name="ExpandedContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#090A0E" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="×" Click="CollapseButton_Click"
                                Background="#20232C" Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="0" FontSize="16" Width="27" Height="27"
                                Cursor="Hand" Margin="8,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="ClockText" Text="14:51" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="DateText" Text="MONDAY, 23 NOVEMBER" Foreground="{DynamicResource MutedTextBrush}" FontSize="7" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TopNavigation" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TopNavButton}" Content="⌂" Tag="Home" ToolTip="Overview" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="♫" Tag="Music" ToolTip="Now playing" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="✓" Tag="Tasks" ToolTip="Tasks" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="◷" Tag="Focus" ToolTip="Focus" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="▤" Tag="Bible" ToolTip="Bible" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="☼" Tag="Weather" ToolTip="Weather" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="▣" Tag="Tray" ToolTip="Tray" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="▧" Tag="Clips" ToolTip="Clipboard" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="▦" Tag="Calendar" ToolTip="Calendar" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="⌘" Tag="System" ToolTip="System" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="◉" Tag="Mirror" ToolTip="Mirror" Click="Navigate_Click"/>
                                <Button Style="{StaticResource TopNavButton}" Content="⚙" Tag="Themes" ToolTip="Themes" Click="Navigate_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#090A0E" Padding="16,12,16,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PageHost">
                                <StackPanel x:Name="HomePage">
                                    <Grid Height="184">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,18,0">
                                            <TextBlock Text="YOUR SPACE" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="A calmer way to work." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="Keep your focus, tasks and everyday tools within reach." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1,0,0,0" Padding="18,8,12,8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="FOCUS SESSION" Style="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="25 min" Foreground="{DynamicResource AccentBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <TextBlock Text="One thing at a time." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1,0,0,0" Padding="18,8,4,8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="OPEN TASKS" Style="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="TaskCountText" Text="0 pending" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <TextBlock Text="Small steps still count." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="MusicPage" Visibility="Collapsed">
                                    <TextBlock Text="Now playing" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Your audio, without leaving the flow." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,12">
                                            <Border Width="82" Height="82" CornerRadius="18" Background="#252D3C" HorizontalAlignment="Center">
                                                <TextBlock Text="♫" Foreground="{DynamicResource AccentBrush}" FontSize="37" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Nothing playing" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,4"/>
                                            <TextBlock Text="No active media session detected." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Previous" IsEnabled="False"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Play / Pause" IsEnabled="False"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Next" IsEnabled="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Media controls will become available when a supported Windows media session is detected." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="TasksPage" Visibility="Collapsed">
                                    <TextBlock Text="Tasks" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Capture it. Then get it done." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="NEW TASK" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Add task" Click="AddTask_Click" Margin="8,0,0,0"/>
                                                <TextBox x:Name="TaskInput" Height="36" VerticalContentAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="YOUR LIST" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold" Margin="2,3,0,8"/>
                                    <ListBox x:Name="TaskList" MaxHeight="250"/>
                                </StackPanel>

                                <StackPanel x:Name="FocusPage" Visibility="Collapsed">
                                    <TextBlock Text="Focus" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="One thing at a time." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,15,0,15">
                                            <Border Width="58" Height="58" CornerRadius="18" Background="#202B39" HorizontalAlignment="Center">
                                                <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="FocusTimeText" Text="25:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="52" FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                            <TextBlock x:Name="FocusStatusText" Text="Ready when you are." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                                <Button Style="{StaticResource ActionButton}" Content="Start" Click="FocusStart_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Pause" Click="FocusPause_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Reset" Click="FocusReset_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="A short, intentional session can be enough to build momentum." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="ThemesPage" Visibility="Collapsed">
                                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Make Selah feel like your space." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="THEME LIBRARY" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="Choose a starting point" Style="{StaticResource Heading}" Margin="0,5,0,10"/>
                                            <ComboBox x:Name="ThemePicker" Height="36" SelectionChanged="ThemePicker_SelectionChanged">
                                                <ComboBoxItem Content="Obsidian"/><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Tokyo Night"/><ComboBoxItem Content="Nord"/><ComboBoxItem Content="Dracula"/><ComboBoxItem Content="Gruvbox"/><ComboBoxItem Content="Rosé Pine"/><ComboBoxItem Content="Sunset"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Cyberpunk"/><ComboBoxItem Content="Synthwave"/><ComboBoxItem Content="Neon City"/><ComboBoxItem Content="Matrix"/><ComboBoxItem Content="Tron"/><ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Lavender"/><ComboBoxItem Content="Arctic"/><ComboBoxItem Content="Ember"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM PALETTE" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="Fine-tune your colors" Style="{StaticResource Heading}" Margin="0,5,0,4"/>
                                            <TextBlock Text="Use HEX values in #RRGGBB format." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Background" Style="{StaticResource Muted}"/><TextBox x:Name="BackgroundColorInput" Text="#101116" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Surface" Style="{StaticResource Muted}"/><TextBox x:Name="SurfaceColorInput" Text="#1B1D27" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Primary accent" Style="{StaticResource Muted}"/><TextBox x:Name="PrimaryColorInput" Text="#72E4FF" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Secondary accent" Style="{StaticResource Muted}"/><TextBox x:Name="SecondaryColorInput" Text="#A78BFA" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Text" Style="{StaticResource Muted}"/><TextBox x:Name="TextColorInput" Text="#F4F6FC" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Muted text" Style="{StaticResource Muted}"/><TextBox x:Name="MutedColorInput" Text="#9BA3B7" Height="32"/></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Border" Style="{StaticResource Muted}"/>
                                            <TextBox x:Name="BorderColorInput" Text="#343746" Height="32" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ActionButton}" Content="Preview" Click="ApplyCustomTheme_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Save palette" Click="SaveCustomTheme_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ThemeStatusText" Text="Changes apply instantly. Save to keep your palette after restart." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="BiblePage" Visibility="Collapsed">
                                    <TextBlock Text="Bible" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Read, reflect, and keep track of your journey." Style="{StaticResource Muted}" Margin="0,0,0,15"/>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="READING VERSION" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Translation" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="BibleTranslationPicker" SelectedIndex="0">
                                                        <ComboBoxItem Content="TB · Terjemahan Baru"/>
                                                        <ComboBoxItem Content="NIV · New International Version"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Book" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="BibleBookPicker" SelectedIndex="0">
                                                        <ComboBoxItem Content="Genesis"/><ComboBoxItem Content="Exodus"/><ComboBoxItem Content="Leviticus"/><ComboBoxItem Content="Numbers"/><ComboBoxItem Content="Deuteronomy"/>
                                                        <ComboBoxItem Content="Joshua"/><ComboBoxItem Content="Judges"/><ComboBoxItem Content="Ruth"/><ComboBoxItem Content="1 Samuel"/><ComboBoxItem Content="2 Samuel"/>
                                                        <ComboBoxItem Content="1 Kings"/><ComboBoxItem Content="2 Kings"/><ComboBoxItem Content="1 Chronicles"/><ComboBoxItem Content="2 Chronicles"/><ComboBoxItem Content="Ezra"/>
                                                        <ComboBoxItem Content="Nehemiah"/><ComboBoxItem Content="Esther"/><ComboBoxItem Content="Job"/><ComboBoxItem Content="Psalms"/><ComboBoxItem Content="Proverbs"/>
                                                        <ComboBoxItem Content="Ecclesiastes"/><ComboBoxItem Content="Song of Songs"/><ComboBoxItem Content="Isaiah"/><ComboBoxItem Content="Jeremiah"/><ComboBoxItem Content="Lamentations"/>
                                                        <ComboBoxItem Content="Ezekiel"/><ComboBoxItem Content="Daniel"/><ComboBoxItem Content="Hosea"/><ComboBoxItem Content="Joel"/><ComboBoxItem Content="Amos"/>
                                                        <ComboBoxItem Content="Obadiah"/><ComboBoxItem Content="Jonah"/><ComboBoxItem Content="Micah"/><ComboBoxItem Content="Nahum"/><ComboBoxItem Content="Habakkuk"/>
                                                        <ComboBoxItem Content="Zephaniah"/><ComboBoxItem Content="Haggai"/><ComboBoxItem Content="Zechariah"/><ComboBoxItem Content="Malachi"/>
                                                        <ComboBoxItem Content="Matthew"/><ComboBoxItem Content="Mark"/><ComboBoxItem Content="Luke"/><ComboBoxItem Content="John"/><ComboBoxItem Content="Acts"/>
                                                        <ComboBoxItem Content="Romans"/><ComboBoxItem Content="1 Corinthians"/><ComboBoxItem Content="2 Corinthians"/><ComboBoxItem Content="Galatians"/><ComboBoxItem Content="Ephesians"/>
                                                        <ComboBoxItem Content="Philippians"/><ComboBoxItem Content="Colossians"/><ComboBoxItem Content="1 Thessalonians"/><ComboBoxItem Content="2 Thessalonians"/><ComboBoxItem Content="1 Timothy"/>
                                                        <ComboBoxItem Content="2 Timothy"/><ComboBoxItem Content="Titus"/><ComboBoxItem Content="Philemon"/><ComboBoxItem Content="Hebrews"/><ComboBoxItem Content="James"/>
                                                        <ComboBoxItem Content="1 Peter"/><ComboBoxItem Content="2 Peter"/><ComboBoxItem Content="1 John"/><ComboBoxItem Content="2 John"/><ComboBoxItem Content="3 John"/>
                                                        <ComboBoxItem Content="Jude"/><ComboBoxItem Content="Revelation"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Chapter" Style="{StaticResource Muted}" Margin="0,11,0,5"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="BibleChapterInput" Text="1" Width="64" VerticalContentAlignment="Center"/>
                                                <Button Style="{StaticResource ActionButton}" Content="Open chapter" IsEnabled="False" Margin="8,0,0,0"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Bookmark" IsEnabled="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="FIND A PASSAGE" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBox x:Name="BibleSearchInput" Margin="0,9,0,8" ToolTip="Search will be available after a licensed Bible text provider is connected."/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="Search Bible" IsEnabled="False" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Search is not active yet. It will use the selected translation's authorized text source." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="READING PANE" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="Choose a passage to begin" Style="{StaticResource Heading}" Margin="0,8,0,5"/>
                                            <TextBlock Text="The Bible text provider has not been connected. Selah will not display copied or unlicensed Bible text." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            <Border Height="1" Background="{DynamicResource IslandBorderBrush}" Margin="0,13,0,10"/>
                                            <TextBlock Text="SUPPORTED VERSIONS" Style="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="TB · Terjemahan Baru (LAI)     NIV · New International Version (Biblica)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="YOUR READING JOURNEY" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="Bookmarks, highlights, notes, reading plans, and reading history" Style="{StaticResource Heading}" Margin="0,8,0,5" TextWrapping="Wrap"/>
                                            <TextBlock Text="These will be stored locally in your Windows user profile. No reading activity is uploaded by this UI shell." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="WeatherPage" Visibility="Collapsed">
                                    <TextBlock Text="Weather" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="A quick look outside." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOCAL CONDITIONS" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Weather overview" Style="{StaticResource Heading}" Margin="0,7,0,5"/><TextBlock Text="Current conditions and hourly forecasts will appear here after a weather provider is connected." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="TrayPage" Visibility="Collapsed">
                                    <TextBlock Text="Drop zone" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Keep useful files close at hand." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" FontSize="35" HorizontalAlignment="Center"/><TextBlock Text="Your temporary shelf" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,10,0,5"/><TextBlock Text="Drag-and-drop file support will be added with Windows shell integration." Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="ClipsPage" Visibility="Collapsed">
                                    <TextBlock Text="Clipboard" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Your copied snippets, kept private." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PRIVATE BY DESIGN" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Clipboard history" Style="{StaticResource Heading}" Margin="0,7,0,5"/><TextBlock Text="Clipboard capture is planned as an opt-in feature. Selah will not upload clipboard contents." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="CalendarPage" Visibility="Collapsed">
                                    <TextBlock Text="Calendar" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="See what is coming up." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UP NEXT" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Your schedule" Style="{StaticResource Heading}" Margin="0,7,0,5"/><TextBlock Text="Calendar events and due tasks will appear here after calendar permissions and provider integration are configured." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                                    <TextBlock Text="System" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Useful controls and device status." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEVICE OVERVIEW" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="System controls" Style="{StaticResource Heading}" Margin="0,7,0,5"/><TextBlock Text="Volume, output devices, device battery and laptop battery information will be integrated here." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="MirrorPage" Visibility="Collapsed">
                                    <TextBlock Text="Mirror" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="A private camera preview." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" FontSize="35" HorizontalAlignment="Center"/><TextBlock Text="Camera preview" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,10,0,5"/><TextBlock Text="The camera will only activate after you explicitly open this feature." Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
