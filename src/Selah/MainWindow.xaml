<Window x:Class="Selah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selah" Width="112" Height="5" MinWidth="112" MaxWidth="820" MinHeight="5" MaxHeight="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" MouseLeave="Window_MouseLeave" Focusable="True">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="27"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="99" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#081218"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TransportSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TransportSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TransportSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TransportSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="IslandSurface"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource IslandBackgroundBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="0" CornerRadius="0,0,28,28" Padding="0"
            ClipToBounds="True"
            MouseEnter="IslandSurface_MouseEnter"
            MouseLeave="IslandSurface_MouseLeave"
            MouseLeftButtonDown="IslandSurface_MouseLeftButtonDown">

        <Grid>
            <!-- Hover state: show only the clock; the idle state stays as a thin notch. -->
            <Grid x:Name="CompactContent" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="CompactClockText"
                           Text="14:51"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="8.6"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded panel follows Nusa's compact 760px floating panel geometry. -->
            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Margin="16,10,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◖" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="QuickVolumeSlider" Width="58" Minimum="0" Maximum="100" Value="50" IsEnabled="False" Height="16" VerticalAlignment="Center" ToolTip="System volume integration not connected"/>
                        <Border Width="1" Height="17" Background="#1AFFFFFF" Margin="5,0"/>
                        <TextBlock Text="◷" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TopNavButton}" Content="5m" Tag="5" Click="QuickTimer_Click" ToolTip="Start 5 minute focus timer"/>
                        <Button Style="{StaticResource TopNavButton}" Content="15m" Tag="15" Click="QuickTimer_Click" ToolTip="Start 15 minute focus timer"/>
                        <Button Style="{StaticResource TopNavButton}" Content="25m" Tag="25" Click="QuickTimer_Click" ToolTip="Start 25 minute focus timer"/>
                        <Border Width="1" Height="17" Background="#1AFFFFFF" Margin="5,0"/>
                        <TextBlock Text="☁  —°" Foreground="#8E8E93" FontSize="9" VerticalAlignment="Center" ToolTip="Weather provider not connected"/>
                        <Border Width="1" Height="17" Background="#1AFFFFFF" Margin="5,0"/>
                        <Button Style="{StaticResource TopNavButton}" Content="⌖" Tag="Pin" ToolTip="Pinning not implemented" IsEnabled="False"/>
                        <Button Style="{StaticResource TopNavButton}" Content="⚙" Tag="Themes" ToolTip="Settings and themes" Click="Navigate_Click"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TopNavigation" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TopNavButton}" Content="⌂" Tag="Home" ToolTip="Home" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="♫" Tag="Music" ToolTip="Music" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="✓" Tag="Tasks" ToolTip="Tasks" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="◷" Tag="Focus" ToolTip="Focus" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="▤" Tag="Bible" ToolTip="Bible" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="▣" Tag="Tray" ToolTip="Tray" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="▧" Tag="Clips" ToolTip="Clipboard" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="◉" Tag="Mirror" ToolTip="Mirror" Click="Navigate_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                        <Grid x:Name="PageHost">
                                <Grid x:Name="HomePage">

<Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0" Margin="0,0,16,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="NOW PLAYING" Foreground="#34D399" FontSize="8" FontWeight="SemiBold"/>
<Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Width="60" Height="60" CornerRadius="16" Background="#18181B" ClipToBounds="True" VerticalAlignment="Top">
<Grid><TextBlock Text="♫" Foreground="#8E8E93" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DashboardArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid>
</Border>
<StackPanel Grid.Column="1" Margin="10,2,0,0">
<TextBlock x:Name="DashboardNowPlayingTitle" Text="Nothing playing" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="DashboardNowPlayingArtist" Text="Start audio on your PC" Foreground="#8E8E93" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="DashboardPlayerStatusText" Text="IDLE" Foreground="#8E8E93" FontSize="7.5" Margin="0,4,0,0"/>
<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
<Button x:Name="DashboardPreviousTrackButton" Style="{StaticResource TopNavButton}" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" Click="PreviousTrack_Click"/>
<Button x:Name="DashboardPlayPauseButton" Style="{StaticResource TopNavButton}" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" Click="PlayPause_Click"/>
<Button x:Name="DashboardNextTrackButton" Style="{StaticResource TopNavButton}" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" IsEnabled="False" Click="NextTrack_Click"/>
</StackPanel>
</StackPanel></Grid>
<Slider x:Name="DashboardSeekBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" IsEnabled="False" Height="12" VerticalAlignment="Bottom" Margin="0,0,0,0" PreviewMouseLeftButtonUp="DashboardSeekBar_Seek"/>
</Grid>
<Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="#1AFFFFFF" Margin="0,5,0,5"/>
<Grid Grid.Column="1" Margin="16,0,16,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><TextBlock Text="AGENDA" Foreground="#8E8E93" FontSize="8" FontWeight="SemiBold" /><TextBlock x:Name="HomeDateText" Text="MONDAY, 23 NOVEMBER" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" DockPanel.Dock="Right"/></DockPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,10,0,10">
<ItemsControl x:Name="HomeWeekStrip">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding ., StringFormat={}{0:ddd}}" Foreground="#8E8E93" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="{Binding ., StringFormat={}{0:dd}}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
<StackPanel Grid.Row="2" Margin="0,0,0,6">
<TextBlock Text="UP NEXT" Foreground="#8E8E93" FontSize="8" FontWeight="SemiBold"/>
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Border Width="2" Height="28" Background="#F59E0B" CornerRadius="2"/><StackPanel Margin="8,0,0,0"><TextBlock Text="Tasks" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="HomeTaskCountText" Text="0 pending" Foreground="#8E8E93" FontSize="8"/></StackPanel></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Border Width="2" Height="28" Background="#34D399" CornerRadius="2"/><StackPanel Margin="8,0,0,0"><TextBlock Text="Focus session" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="DashboardFocusTimeText" Text="25:00" Foreground="#8E8E93" FontSize="8" FontFamily="Segoe UI"/></StackPanel></StackPanel>
</StackPanel>
<StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource TopNavButton}" Content="Open tasks" Tag="Tasks" Click="Navigate_Click"/><Button Style="{StaticResource TopNavButton}" Content="Start focus" Click="FocusStart_Click"/></StackPanel>
</Grid>
<Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="#1AFFFFFF" Margin="0,5,0,5"/>
<Grid Grid.Column="2" Margin="16,0,0,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TopNavButton}" Content="◎" ToolTip="Camera integration not connected" IsEnabled="False"/>
<StackPanel Grid.Row="1" Margin="0,2,0,0"><TextBlock Text="☁" Foreground="#8E8E93" FontSize="19"/><TextBlock Text="—°" Foreground="#FFFFFF" FontSize="30" FontWeight="Bold"/><TextBlock Text="Weather unavailable" Foreground="#8E8E93" FontSize="8"/><TextBlock Text="Connect a weather provider" Foreground="#8E8E93" FontSize="7" Margin="0,2,0,0"/></StackPanel>
<UniformGrid Grid.Row="2" Rows="1" Columns="4" VerticalAlignment="Bottom" Margin="0,12,0,0">
<StackPanel><TextBlock Text="NOW" Foreground="#8E8E93" FontSize="7"/><TextBlock Text="—" Foreground="#FFFFFF" FontSize="10"/><TextBlock Text="—%" Foreground="#60A5FA" FontSize="8"/></StackPanel>
<StackPanel><TextBlock Text="+1h" Foreground="#8E8E93" FontSize="7"/><TextBlock Text="—" Foreground="#FFFFFF" FontSize="10"/><TextBlock Text="—%" Foreground="#60A5FA" FontSize="8"/></StackPanel>
<StackPanel><TextBlock Text="+2h" Foreground="#8E8E93" FontSize="7"/><TextBlock Text="—" Foreground="#FFFFFF" FontSize="10"/><TextBlock Text="—%" Foreground="#60A5FA" FontSize="8"/></StackPanel>
<StackPanel><TextBlock Text="+3h" Foreground="#8E8E93" FontSize="7"/><TextBlock Text="—" Foreground="#FFFFFF" FontSize="10"/><TextBlock Text="—%" Foreground="#60A5FA" FontSize="8"/></StackPanel>
</UniformGrid></Grid>
<TextBox x:Name="DashboardTaskInput" Visibility="Collapsed"/>
<ListBox x:Name="DashboardTaskList" Visibility="Collapsed"/>
<TextBlock x:Name="DashboardTaskSummaryText" Visibility="Collapsed"/>
</Grid>
<Grid x:Name="MusicPage" Visibility="Collapsed">
<Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Width="136" Height="136" CornerRadius="18" Background="#18181B" ClipToBounds="True" VerticalAlignment="Center"><Grid><TextBlock Text="♫" Foreground="#8E8E93" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="MediaArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid></Border>
<StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
<TextBlock x:Name="PlayerStatusText" Text="WAITING FOR MEDIA" Foreground="#34D399" FontSize="8" FontWeight="SemiBold"/>
<TextBlock x:Name="PlayerTitleText" Text="Nothing playing" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,2"/>
<TextBlock x:Name="PlayerArtistText" Text="Open Spotify or another media app" Foreground="#8E8E93" FontSize="10"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
<Button x:Name="PreviousTrackButton" Style="{StaticResource TopNavButton}" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="17" IsEnabled="False" Click="PreviousTrack_Click"/>
<Button x:Name="PlayPauseButton" Style="{StaticResource TopNavButton}" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" IsEnabled="False" Click="PlayPause_Click" Margin="14,0"/>
<Button x:Name="NextTrackButton" Style="{StaticResource TopNavButton}" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="17" IsEnabled="False" Click="NextTrack_Click"/>
</StackPanel>
<Slider x:Name="PlayerSeekBar" Minimum="0" Maximum="100" Value="0" IsEnabled="False" Height="14" PreviewMouseLeftButtonUp="PlayerSeekBar_Seek" KeyUp="PlayerSeekBar_KeyUp"/>
<DockPanel><TextBlock x:Name="PlayerPositionText" Text="0:00" Foreground="#8E8E93" FontSize="8" DockPanel.Dock="Left"/><TextBlock x:Name="PlayerDurationText" Text="0:00" Foreground="#8E8E93" FontSize="8" DockPanel.Dock="Right"/></DockPanel>
</StackPanel></Grid>

<StackPanel x:Name="TasksPage" Visibility="Collapsed">
<DockPanel LastChildFill="True">
<Button DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Content="＋" FontSize="15" Padding="10,5" Click="AddTask_Click" ToolTip="Add task" Margin="0,0,8,0"/>
<TextBox x:Name="TaskInput" Height="36" FontSize="11" VerticalContentAlignment="Center" ToolTip="What needs to get done?" />
</DockPanel>
<Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource TopNavButton}" Content="In 30 min" Tag="30" Click="TaskSchedule_Click"/>
<Button Style="{StaticResource TopNavButton}" Content="In 1 hour" Tag="60" Click="TaskSchedule_Click"/>
<Button Style="{StaticResource TopNavButton}" Content="Tonight 20:00" Tag="Tonight" Click="TaskSchedule_Click"/>
<Button Style="{StaticResource TopNavButton}" Content="Tomorrow 09:00" Tag="Tomorrow" Click="TaskSchedule_Click"/>
</StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ActionButton}" Content="Focus 25m" Click="FocusStart_Click"/><TextBlock x:Name="TaskSummaryText" Text="0 open · 0 done" Foreground="#8E8E93" FontSize="8" VerticalAlignment="Center"/></StackPanel>
</Grid>
<DockPanel Margin="2,0,2,6"><TextBlock Text="YOUR TASKS" Foreground="#8E8E93" FontSize="8" FontWeight="SemiBold"/><TextBlock x:Name="TaskCountText" Text="0 pending" Foreground="#8E8E93" FontSize="8" DockPanel.Dock="Right"/></DockPanel>
<ListBox x:Name="TaskList" MaxHeight="190" ScrollViewer.VerticalScrollBarVisibility="Hidden">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding DueAt, StringFormat={}{0:HH:mm}}" Foreground="#8E8E93" FontSize="8" VerticalAlignment="Center" Margin="8,0"/><Button Grid.Column="3" Content="×" Foreground="#8E8E93" Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="RemoveTask_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<TextBlock x:Name="TaskEmptyText" Text="No tasks yet" Foreground="#8E8E93" FontSize="9" TextAlignment="Center" Margin="0,8,0,0"/>
</StackPanel>

<StackPanel x:Name="FocusPage" Visibility="Collapsed">
                                    
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,8,0,8">
                                            <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="24.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="FocusTimeText" Text="25:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                            <TextBlock x:Name="FocusStatusText" Text="Ready" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="9"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                <Button Style="{StaticResource ActionButton}" Content="Start" Click="FocusStart_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Pause" Click="FocusPause_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Reset" Click="FocusReset_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    
                                </StackPanel>

                                <StackPanel x:Name="ThemesPage" Visibility="Collapsed">
                                    
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            
                                            <ComboBox x:Name="ThemePicker" Height="27" SelectionChanged="ThemePicker_SelectionChanged">
                                                <ComboBoxItem Content="Obsidian"/><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Tokyo Night"/><ComboBoxItem Content="Nord"/><ComboBoxItem Content="Dracula"/><ComboBoxItem Content="Gruvbox"/><ComboBoxItem Content="Rosé Pine"/><ComboBoxItem Content="Sunset"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Cyberpunk"/><ComboBoxItem Content="Synthwave"/><ComboBoxItem Content="Neon City"/><ComboBoxItem Content="Matrix"/><ComboBoxItem Content="Tron"/><ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Lavender"/><ComboBoxItem Content="Arctic"/><ComboBoxItem Content="Ember"/><ComboBoxItem Content="Paper"/><ComboBoxItem Content="Snow"/><ComboBoxItem Content="Solarized Light"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            
                                            
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Background" Style="{StaticResource Muted}"/><TextBox x:Name="BackgroundColorInput" Text="#101116" Height="25"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Surface" Style="{StaticResource Muted}"/><TextBox x:Name="SurfaceColorInput" Text="#1B1D27" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Primary accent" Style="{StaticResource Muted}"/><TextBox x:Name="PrimaryColorInput" Text="#72E4FF" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Secondary accent" Style="{StaticResource Muted}"/><TextBox x:Name="SecondaryColorInput" Text="#A78BFA" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Text" Style="{StaticResource Muted}"/><TextBox x:Name="TextColorInput" Text="#F4F6FC" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Muted text" Style="{StaticResource Muted}"/><TextBox x:Name="MutedColorInput" Text="#9BA3B7" Height="32"/></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Border" Style="{StaticResource Muted}"/>
                                            <TextBox x:Name="BorderColorInput" Text="#343746" Height="32" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ActionButton}" Content="Preview" Click="ApplyCustomTheme_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Save palette" Click="SaveCustomTheme_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ThemeStatusText" Text="Ready" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="BiblePage" Visibility="Collapsed">
                                    
                                    

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    
                                                    <ComboBox x:Name="BibleTranslationPicker" Height="26" SelectedIndex="0">
                                                        <ComboBoxItem Content="TB · Terjemahan Baru"/>
                                                        <ComboBoxItem Content="NIV · New International Version"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    
                                                    <ComboBox x:Name="BibleBookPicker" Height="26" SelectedIndex="0">
                                                        <ComboBoxItem Content="Genesis"/><ComboBoxItem Content="Exodus"/><ComboBoxItem Content="Leviticus"/><ComboBoxItem Content="Numbers"/><ComboBoxItem Content="Deuteronomy"/>
                                                        <ComboBoxItem Content="Joshua"/><ComboBoxItem Content="Judges"/><ComboBoxItem Content="Ruth"/><ComboBoxItem Content="1 Samuel"/><ComboBoxItem Content="2 Samuel"/>
                                                        <ComboBoxItem Content="1 Kings"/><ComboBoxItem Content="2 Kings"/><ComboBoxItem Content="1 Chronicles"/><ComboBoxItem Content="2 Chronicles"/><ComboBoxItem Content="Ezra"/>
                                                        <ComboBoxItem Content="Nehemiah"/><ComboBoxItem Content="Esther"/><ComboBoxItem Content="Job"/><ComboBoxItem Content="Psalms"/><ComboBoxItem Content="Proverbs"/>
                                                        <ComboBoxItem Content="Ecclesiastes"/><ComboBoxItem Content="Song of Songs"/><ComboBoxItem Content="Isaiah"/><ComboBoxItem Content="Jeremiah"/><ComboBoxItem Content="Lamentations"/>
                                                        <ComboBoxItem Content="Ezekiel"/><ComboBoxItem Content="Daniel"/><ComboBoxItem Content="Hosea"/><ComboBoxItem Content="Joel"/><ComboBoxItem Content="Amos"/>
                                                        <ComboBoxItem Content="Obadiah"/><ComboBoxItem Content="Jonah"/><ComboBoxItem Content="Micah"/><ComboBoxItem Content="Nahum"/><ComboBoxItem Content="Habakkuk"/>
                                                        <ComboBoxItem Content="Zephaniah"/><ComboBoxItem Content="Haggai"/><ComboBoxItem Content="Zechariah"/><ComboBoxItem Content="Malachi"/>
                                                        <ComboBoxItem Content="Matthew"/><ComboBoxItem Content="Mark"/><ComboBoxItem Content="Luke"/><ComboBoxItem Content="John"/><ComboBoxItem Content="Acts"/>
                                                        <ComboBoxItem Content="Romans"/><ComboBoxItem Content="1 Corinthians"/><ComboBoxItem Content="2 Corinthians"/><ComboBoxItem Content="Galatians"/><ComboBoxItem Content="Ephesians"/>
                                                        <ComboBoxItem Content="Philippians"/><ComboBoxItem Content="Colossians"/><ComboBoxItem Content="1 Thessalonians"/><ComboBoxItem Content="2 Thessalonians"/><ComboBoxItem Content="1 Timothy"/>
                                                        <ComboBoxItem Content="2 Timothy"/><ComboBoxItem Content="Titus"/><ComboBoxItem Content="Philemon"/><ComboBoxItem Content="Hebrews"/><ComboBoxItem Content="James"/>
                                                        <ComboBoxItem Content="1 Peter"/><ComboBoxItem Content="2 Peter"/><ComboBoxItem Content="1 John"/><ComboBoxItem Content="2 John"/><ComboBoxItem Content="3 John"/>
                                                        <ComboBoxItem Content="Jude"/><ComboBoxItem Content="Revelation"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Ch." Style="{StaticResource Muted}" Margin="0,5,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="BibleChapterInput" Text="1" Width="64" VerticalContentAlignment="Center"/>
                                                <Button Style="{StaticResource ActionButton}" Content="↵" ToolTip="Open chapter" IsEnabled="False" Padding="8,3" Margin="5,0,0,0"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="☆" ToolTip="Bookmark" IsEnabled="False" Padding="8,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBox x:Name="BibleSearchInput" Height="26" Margin="0,3,0,4" ToolTip="Search will be available after a licensed Bible text provider is connected."/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="⌕" ToolTip="Search Bible" IsEnabled="False" HorizontalAlignment="Left" Padding="8,3"/>
                                            
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBlock Text="Select a passage" Style="{StaticResource Heading}" Margin="0,2,0,3"/>
                                            <TextBlock Text="Text source not connected" Style="{StaticResource Muted}" FontSize="9"/>
                                            <Border Height="1" Background="{DynamicResource IslandBorderBrush}" Margin="0,6,0,5"/>
                                            
                                            <TextBlock Text="TB · NIV" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBlock Text="☆ Bookmarks   ✎ Notes   ▤ Plans" Style="{StaticResource Heading}" FontSize="10"/>
                                            
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="WeatherPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="☼ Weather" Style="{StaticResource Heading}"/><TextBlock Text="Provider not connected" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="TrayPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Drop zone" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,4,0,2"/><TextBlock Text="Coming soon" Style="{StaticResource Muted}" FontSize="9" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="ClipsPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Clipboard" Style="{StaticResource Heading}"/><TextBlock Text="Coming soon · opt-in" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="CalendarPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Calendar" Style="{StaticResource Heading}"/><TextBlock Text="No calendar provider" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="⌘ System" Style="{StaticResource Heading}"/><TextBlock Text="Controls not connected" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="MirrorPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Mirror" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,4,0,2"/><TextBlock Text="Camera inactive" Style="{StaticResource Muted}" FontSize="9" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
