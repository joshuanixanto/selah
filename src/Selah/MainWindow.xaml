<Window x:Class="Selah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selah" Width="360" Height="64" MinWidth="360" MaxWidth="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Border x:Name="IslandSurface" Background="{StaticResource IslandBackgroundBrush}"
            CornerRadius="24" BorderBrush="#303442" BorderThickness="1" Padding="18,12">
        <Grid>
            <Grid x:Name="CompactContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                         VerticalAlignment="Center" Margin="2,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SELAH" Foreground="White" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Your desktop, in harmony."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="＋" Click="ExpandButton_Click"
                        ToolTip="Expand Selah" Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="18" Padding="8,0" Cursor="Hand" />
            </Grid>
            <Grid x:Name="ExpandedContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="SELAH" Foreground="White" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="A quiet space for your workflow"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="－" Click="CollapseButton_Click"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="18" Padding="8,0" Cursor="Hand" />
                </DockPanel>
                <Border Grid.Row="1" Background="#202432" CornerRadius="16"
                        Padding="16" Margin="0,18,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Selah" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="The Dynamic Island foundation is ready. Widgets and Windows integrations will be added in separate modules."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="SELAH FOR WINDOWS  •  EARLY BUILD"
                           Foreground="#687084" FontSize="9" HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
