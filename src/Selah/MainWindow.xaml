<Window x:Class="Selah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selah" Width="112" Height="5" MinWidth="112" MaxWidth="660" MinHeight="5" MaxHeight="400"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" MouseLeave="Window_MouseLeave" Focusable="True">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="27"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="99" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#081218"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TransportSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TransportSurface" Property="Background" Value="{DynamicResource IslandBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TransportSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TransportSurface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="IslandSurface"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource IslandBackgroundBrush}"
            BorderBrush="{DynamicResource IslandBorderBrush}"
            BorderThickness="0" CornerRadius="0,0,2.5,2.5" Padding="0"
            ClipToBounds="True"
            MouseEnter="IslandSurface_MouseEnter"
            MouseLeave="IslandSurface_MouseLeave"
            MouseLeftButtonDown="IslandSurface_MouseLeftButtonDown">

        <Grid>
            <!-- Hover state: show only the clock; the idle state stays as a thin notch. -->
            <Grid x:Name="CompactContent" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="CompactClockText"
                           Text="14:51"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="8.6"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded panel follows Nusa's compact 760px floating panel geometry. -->
            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Margin="10,6,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <Button Style="{StaticResource TopNavButton}" Content="⚙" Tag="Themes" ToolTip="Appearance and themes" Click="Navigate_Click"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TopNavigation" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TopNavButton}" Content="⌂" Tag="Home" ToolTip="Overview" Click="Navigate_Click"/>



                            <Button Style="{StaticResource TopNavButton}" Content="▤" Tag="Bible" ToolTip="Bible" Click="Navigate_Click"/>

                            <Button Style="{StaticResource TopNavButton}" Content="▣" Tag="Tray" ToolTip="Tray" Click="Navigate_Click"/>
                            <Button Style="{StaticResource TopNavButton}" Content="▧" Tag="Clips" ToolTip="Clipboard" Click="Navigate_Click"/>


                            <Button Style="{StaticResource TopNavButton}" Content="◉" Tag="Mirror" ToolTip="Mirror" Click="Navigate_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                        <Grid x:Name="PageHost">
                                <Grid x:Name="HomePage">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="1,0,1,0">
<TextBlock x:Name="HomeDateText" Text="MONDAY, 23 NOVEMBER" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" FontWeight="SemiBold" DockPanel.Dock="Left"/>
<TextBlock x:Name="HomeTaskCountText" Text="0 pending" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" HorizontalAlignment="Right"/>
</DockPanel>
<Grid Grid.Row="2">
<Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="38" Height="38" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" ClipToBounds="True" VerticalAlignment="Center">
<Grid><TextBlock Text="♫" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DashboardArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid>
</Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
<TextBlock x:Name="DashboardNowPlayingTitle" Text="Nothing playing" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="DashboardNowPlayingArtist" Text="Start audio on your PC" Style="{StaticResource Muted}" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="DashboardPlayerStatusText" Text="Idle" Style="{StaticResource Muted}" FontSize="7.5" Margin="0,2,0,0"/>
</StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
<Button x:Name="DashboardPreviousTrackButton" Style="{StaticResource TransportButton}" Content="&#xE892;" Click="PreviousTrack_Click" IsEnabled="False" ToolTip="Previous" Width="23" Height="23"/>
<Button x:Name="DashboardPlayPauseButton" Style="{StaticResource TransportButton}" Content="&#xE768;" Click="PlayPause_Click" IsEnabled="False" ToolTip="Play / pause" Width="27" Height="27" Margin="2,0"/>
<Button x:Name="DashboardNextTrackButton" Style="{StaticResource TransportButton}" Content="&#xE893;" Click="NextTrack_Click" IsEnabled="False" ToolTip="Next" Width="23" Height="23"/>
</StackPanel></Grid>
<Slider x:Name="DashboardSeekBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" IsEnabled="False" Height="10" Margin="0,2,0,0" PreviewMouseLeftButtonUp="DashboardSeekBar_Seek" ToolTip="Seek"/>
</Grid>
<StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,0">
<DockPanel><TextBlock Text="✓  TASKS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock x:Name="DashboardTaskSummaryText" Text="0 open" Foreground="{DynamicResource MutedTextBrush}" FontSize="7.5" HorizontalAlignment="Right"/></DockPanel>
<DockPanel Margin="0,4,0,3"><Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="＋" FontSize="11" Padding="5,0" Click="DashboardAddTask_Click" ToolTip="Add task" Margin="3,0,0,0"/><TextBox x:Name="DashboardTaskInput" Height="21" FontSize="8.5" VerticalContentAlignment="Center" ToolTip="New task"/></DockPanel>
<ListBox x:Name="DashboardTaskList" MaxHeight="42" ScrollViewer.VerticalScrollBarVisibility="Hidden" BorderThickness="0" Background="Transparent">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox></StackPanel>
<Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{DynamicResource IslandBorderBrush}" Opacity="0.65"/>
<Grid Grid.Row="2" Grid.Column="0" Margin="0,5,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="◷  FOCUS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold"/>
<TextBlock x:Name="DashboardFocusTimeText" Grid.Row="1" Text="25:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource ActionButton}" Content="▶" Click="FocusStart_Click" Padding="6,1" ToolTip="Start"/><Button Style="{StaticResource SecondaryButton}" Content="Ⅱ" Click="FocusPause_Click" Padding="6,1" ToolTip="Pause"/><Button Style="{StaticResource SecondaryButton}" Content="↺" Click="FocusReset_Click" Padding="6,1" ToolTip="Reset"/></StackPanel>
</Grid>
<Border Grid.Row="2" Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,8,0,5" Background="{DynamicResource IslandBorderBrush}" Opacity="0.65"/>
<StackPanel Grid.Row="2" Grid.Column="1" Margin="10,7,8,0" VerticalAlignment="Center"><TextBlock Text="☼  WEATHER" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="—°" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Light" Margin="0,3,0,0"/><TextBlock Text="Not connected" Foreground="{DynamicResource MutedTextBrush}" FontSize="8"/></StackPanel>
<Border Grid.Row="2" Grid.Column="2" Width="1" HorizontalAlignment="Left" Margin="0,8,0,5" Background="{DynamicResource IslandBorderBrush}" Opacity="0.65"/>
<StackPanel Grid.Row="2" Grid.Column="2" Margin="10,7,0,0" VerticalAlignment="Center"><TextBlock Text="▦  CALENDAR" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="No events" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" Margin="0,3,0,5"/><TextBlock Text="⌘  SYSTEM" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="Controls offline" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" Margin="0,2,0,0"/></StackPanel>
</Grid></Grid>

                                <StackPanel x:Name="MusicPage" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}" Padding="10" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="68" Height="68" CornerRadius="9" Background="{DynamicResource IslandBackgroundBrush}" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="♫" Foreground="{DynamicResource AccentBrush}" FontSize="25" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="MediaArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock x:Name="PlayerTitleText" Text="Nothing playing" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="PlayerArtistText" Text="Open Spotify or another media app" Style="{StaticResource Muted}" FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="PlayerStatusText" Text="Waiting for a media session" Style="{StaticResource Muted}" FontSize="8.5" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Slider x:Name="PlayerSeekBar" Grid.Row="0" Minimum="0" Maximum="100" Value="0" IsEnabled="False" VerticalAlignment="Center" Height="18" PreviewMouseLeftButtonUp="PlayerSeekBar_Seek" KeyUp="PlayerSeekBar_KeyUp"/>
                                                <DockPanel Grid.Row="1" Margin="1,0,1,0">
                                                    <TextBlock x:Name="PlayerPositionText" Text="0:00" Style="{StaticResource Muted}" FontSize="8" DockPanel.Dock="Left"/>
                                                    <TextBlock x:Name="PlayerDurationText" Text="0:00" Style="{StaticResource Muted}" FontSize="8" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,0">
                                                <Button x:Name="PreviousTrackButton" Style="{StaticResource TransportButton}" Content="&#xE892;" Click="PreviousTrack_Click" IsEnabled="False" ToolTip="Previous track" Width="30" Height="30"/>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" Content="&#xE768;" Click="PlayPause_Click" IsEnabled="False" ToolTip="Play or pause" Width="36" Height="36" FontSize="15" Margin="9,0"/>
                                                <Button x:Name="NextTrackButton" Style="{StaticResource TransportButton}" Content="&#xE893;" Click="NextTrack_Click" IsEnabled="False" ToolTip="Next track" Width="30" Height="30"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                
                                <StackPanel x:Name="TasksPage" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="✓" Style="{StaticResource Heading}" VerticalAlignment="Center" ToolTip="Tasks"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="8,4">
                                            <TextBlock x:Name="TaskSummaryText" Text="0 open · 0 done" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,7">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="＋" FontSize="14" Padding="9,2" Click="AddTask_Click" Margin="8,0,0,0" ToolTip="Add task"/>
                                            <TextBox x:Name="TaskInput" Height="26" VerticalContentAlignment="Center" ToolTip="What needs to get done?" />
                                        </DockPanel>
                                    </Border>
                                    <DockPanel Margin="2,0,2,5">
                                        
                                        <TextBlock x:Name="TaskCountText" Text="0 pending" Foreground="{DynamicResource MutedTextBrush}" FontSize="8.3" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ListBox x:Name="TaskList" MaxHeight="185" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Opacity" Value="0.48"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="RemoveTask_Click" ToolTip="Delete task"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="TaskEmptyText" Text="No tasks" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="FocusPage" Visibility="Collapsed">
                                    
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,8,0,8">
                                            <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="24.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="FocusTimeText" Text="25:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                            <TextBlock x:Name="FocusStatusText" Text="Ready" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="9"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                <Button Style="{StaticResource ActionButton}" Content="Start" Click="FocusStart_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Pause" Click="FocusPause_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Reset" Click="FocusReset_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    
                                </StackPanel>

                                <StackPanel x:Name="ThemesPage" Visibility="Collapsed">
                                    
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            
                                            <ComboBox x:Name="ThemePicker" Height="27" SelectionChanged="ThemePicker_SelectionChanged">
                                                <ComboBoxItem Content="Obsidian"/><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Tokyo Night"/><ComboBoxItem Content="Nord"/><ComboBoxItem Content="Dracula"/><ComboBoxItem Content="Gruvbox"/><ComboBoxItem Content="Rosé Pine"/><ComboBoxItem Content="Sunset"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Cyberpunk"/><ComboBoxItem Content="Synthwave"/><ComboBoxItem Content="Neon City"/><ComboBoxItem Content="Matrix"/><ComboBoxItem Content="Tron"/><ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Lavender"/><ComboBoxItem Content="Arctic"/><ComboBoxItem Content="Ember"/><ComboBoxItem Content="Paper"/><ComboBoxItem Content="Snow"/><ComboBoxItem Content="Solarized Light"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            
                                            
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Background" Style="{StaticResource Muted}"/><TextBox x:Name="BackgroundColorInput" Text="#101116" Height="25"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Surface" Style="{StaticResource Muted}"/><TextBox x:Name="SurfaceColorInput" Text="#1B1D27" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Primary accent" Style="{StaticResource Muted}"/><TextBox x:Name="PrimaryColorInput" Text="#72E4FF" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Secondary accent" Style="{StaticResource Muted}"/><TextBox x:Name="SecondaryColorInput" Text="#A78BFA" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,8,9"><TextBlock Text="Text" Style="{StaticResource Muted}"/><TextBox x:Name="TextColorInput" Text="#F4F6FC" Height="32"/></StackPanel>
                                                <StackPanel Margin="0,0,0,9"><TextBlock Text="Muted text" Style="{StaticResource Muted}"/><TextBox x:Name="MutedColorInput" Text="#9BA3B7" Height="32"/></StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Border" Style="{StaticResource Muted}"/>
                                            <TextBox x:Name="BorderColorInput" Text="#343746" Height="32" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ActionButton}" Content="Preview" Click="ApplyCustomTheme_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Save palette" Click="SaveCustomTheme_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ThemeStatusText" Text="Ready" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="BiblePage" Visibility="Collapsed">
                                    
                                    

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    
                                                    <ComboBox x:Name="BibleTranslationPicker" Height="26" SelectedIndex="0">
                                                        <ComboBoxItem Content="TB · Terjemahan Baru"/>
                                                        <ComboBoxItem Content="NIV · New International Version"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    
                                                    <ComboBox x:Name="BibleBookPicker" Height="26" SelectedIndex="0">
                                                        <ComboBoxItem Content="Genesis"/><ComboBoxItem Content="Exodus"/><ComboBoxItem Content="Leviticus"/><ComboBoxItem Content="Numbers"/><ComboBoxItem Content="Deuteronomy"/>
                                                        <ComboBoxItem Content="Joshua"/><ComboBoxItem Content="Judges"/><ComboBoxItem Content="Ruth"/><ComboBoxItem Content="1 Samuel"/><ComboBoxItem Content="2 Samuel"/>
                                                        <ComboBoxItem Content="1 Kings"/><ComboBoxItem Content="2 Kings"/><ComboBoxItem Content="1 Chronicles"/><ComboBoxItem Content="2 Chronicles"/><ComboBoxItem Content="Ezra"/>
                                                        <ComboBoxItem Content="Nehemiah"/><ComboBoxItem Content="Esther"/><ComboBoxItem Content="Job"/><ComboBoxItem Content="Psalms"/><ComboBoxItem Content="Proverbs"/>
                                                        <ComboBoxItem Content="Ecclesiastes"/><ComboBoxItem Content="Song of Songs"/><ComboBoxItem Content="Isaiah"/><ComboBoxItem Content="Jeremiah"/><ComboBoxItem Content="Lamentations"/>
                                                        <ComboBoxItem Content="Ezekiel"/><ComboBoxItem Content="Daniel"/><ComboBoxItem Content="Hosea"/><ComboBoxItem Content="Joel"/><ComboBoxItem Content="Amos"/>
                                                        <ComboBoxItem Content="Obadiah"/><ComboBoxItem Content="Jonah"/><ComboBoxItem Content="Micah"/><ComboBoxItem Content="Nahum"/><ComboBoxItem Content="Habakkuk"/>
                                                        <ComboBoxItem Content="Zephaniah"/><ComboBoxItem Content="Haggai"/><ComboBoxItem Content="Zechariah"/><ComboBoxItem Content="Malachi"/>
                                                        <ComboBoxItem Content="Matthew"/><ComboBoxItem Content="Mark"/><ComboBoxItem Content="Luke"/><ComboBoxItem Content="John"/><ComboBoxItem Content="Acts"/>
                                                        <ComboBoxItem Content="Romans"/><ComboBoxItem Content="1 Corinthians"/><ComboBoxItem Content="2 Corinthians"/><ComboBoxItem Content="Galatians"/><ComboBoxItem Content="Ephesians"/>
                                                        <ComboBoxItem Content="Philippians"/><ComboBoxItem Content="Colossians"/><ComboBoxItem Content="1 Thessalonians"/><ComboBoxItem Content="2 Thessalonians"/><ComboBoxItem Content="1 Timothy"/>
                                                        <ComboBoxItem Content="2 Timothy"/><ComboBoxItem Content="Titus"/><ComboBoxItem Content="Philemon"/><ComboBoxItem Content="Hebrews"/><ComboBoxItem Content="James"/>
                                                        <ComboBoxItem Content="1 Peter"/><ComboBoxItem Content="2 Peter"/><ComboBoxItem Content="1 John"/><ComboBoxItem Content="2 John"/><ComboBoxItem Content="3 John"/>
                                                        <ComboBoxItem Content="Jude"/><ComboBoxItem Content="Revelation"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Ch." Style="{StaticResource Muted}" Margin="0,5,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="BibleChapterInput" Text="1" Width="64" VerticalContentAlignment="Center"/>
                                                <Button Style="{StaticResource ActionButton}" Content="↵" ToolTip="Open chapter" IsEnabled="False" Padding="8,3" Margin="5,0,0,0"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="☆" ToolTip="Bookmark" IsEnabled="False" Padding="8,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBox x:Name="BibleSearchInput" Height="26" Margin="0,3,0,4" ToolTip="Search will be available after a licensed Bible text provider is connected."/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="⌕" ToolTip="Search Bible" IsEnabled="False" HorizontalAlignment="Left" Padding="8,3"/>
                                            
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBlock Text="Select a passage" Style="{StaticResource Heading}" Margin="0,2,0,3"/>
                                            <TextBlock Text="Text source not connected" Style="{StaticResource Muted}" FontSize="9"/>
                                            <Border Height="1" Background="{DynamicResource IslandBorderBrush}" Margin="0,6,0,5"/>
                                            
                                            <TextBlock Text="TB · NIV" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            
                                            <TextBlock Text="☆ Bookmarks   ✎ Notes   ▤ Plans" Style="{StaticResource Heading}" FontSize="10"/>
                                            
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="WeatherPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="☼ Weather" Style="{StaticResource Heading}"/><TextBlock Text="Provider not connected" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="TrayPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Drop zone" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,4,0,2"/><TextBlock Text="Coming soon" Style="{StaticResource Muted}" FontSize="9" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="ClipsPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Clipboard" Style="{StaticResource Heading}"/><TextBlock Text="Coming soon · opt-in" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="CalendarPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Calendar" Style="{StaticResource Heading}"/><TextBlock Text="No calendar provider" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="⌘ System" Style="{StaticResource Heading}"/><TextBlock Text="Controls not connected" Style="{StaticResource Muted}" FontSize="9"/></StackPanel></Border>
                                </StackPanel>
                                <StackPanel x:Name="MirrorPage" Visibility="Collapsed">
                                    
                                    
                                    <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" Margin="0,15"><TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Mirror" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,4,0,2"/><TextBlock Text="Camera inactive" Style="{StaticResource Muted}" FontSize="9" TextAlignment="Center"/></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
